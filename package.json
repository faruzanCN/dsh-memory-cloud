{
  "name": "dsh-memory-cloud",
  "version": "1.3.1",
  "type": "module",
  "description": "Visualize every DSH session memory as an interactive 3D nebula, with a neuron-signal skin and zoom-driven detail levels.",
  "license": "MIT",
  "author": "faruzanCN",
  "homepage": "https://github.com/faruzanCN/dsh-memory-cloud#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faruzanCN/dsh-memory-cloud.git"
  },
  "bugs": {
    "url": "https://github.com/faruzanCN/dsh-memory-cloud/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "visualization",
    "nebula",
    "neuron",
    "canvas",
    "3d"
  ],
  "engines": {
    "node": ">=22.15.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./nebula.html": "./nebula.html",
    "./nebula.css": "./nebula.css",
    "./nebula.js": "./nebula.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./assets/*": "./assets/*"
  },
  "files": [
    "index.js",
    "client.js",
    "nebula.html",
    "nebula.css",
    "nebula.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/*"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
